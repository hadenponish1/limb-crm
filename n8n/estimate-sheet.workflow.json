{
  "name": "Limb — Estimate sheet",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "estimate-sheet",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Webhook",
      "webhookId": "a1111111-1111-4111-8111-111111111111"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/1k87yAT_xsNHRgYZKFX3nEW1SqaeR3kX9m9t1vZmD-T8/copy",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": \"Estimate \" + $json.body.estimateId + \" — \" + $json.body.clientName } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Copy template",
      "credentials": {
        "googleDriveOAuth2Api": { "id": "REPLACE_ME", "name": "Google Drive account" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.id }}/values:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"valueInputOption\": \"USER_ENTERED\", \"data\": [ { \"range\": \"Estimate!C5\", \"values\": [[ $('Webhook').item.json.body.clientName ]] }, { \"range\": \"Estimate!C6\", \"values\": [[ $('Webhook').item.json.body.address ]] }, { \"range\": \"Estimate!C7\", \"values\": [[ ($('Webhook').item.json.body.phone || '') + ' · ' + ($('Webhook').item.json.body.email || '') ]] }, { \"range\": \"Estimate!C8\", \"values\": [[ $('Webhook').item.json.body.estimateId ]] }, { \"range\": \"Estimate!C9\", \"values\": [[ $('Webhook').item.json.body.date ]] }, { \"range\": \"Estimate!C10\", \"values\": [[ $('Webhook').item.json.body.validUntil ]] }, { \"range\": \"Estimate!C11\", \"values\": [[ $('Webhook').item.json.body.jobName ]] } ] } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Prefill cells",
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"url\": \"https://docs.google.com/spreadsheets/d/\" + $('Copy template').item.json.id + \"/edit\", \"estimateId\": $('Webhook').item.json.body.estimateId } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 0],
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Respond"
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Copy template", "type": "main", "index": 0 }]] },
    "Copy template": { "main": [[{ "node": "Prefill cells", "type": "main", "index": 0 }]] },
    "Prefill cells": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
